# Dependencies
node_modules/
.pnpm-store/

# Build output
lib/
dist/
*.tsbuildinfo

# Test output
coverage/
.vitest/

# Local environment
.env
.env.*
!.env.example

# npm credentials: a publish token lives here and must never be committed.
# `.npmrc.example` documents the expected shape without a secret.
.npmrc
.npmrc.local

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Local scratch
.tmp/
scratch/
# Parallel-agent checkouts. Each one is a real git worktree, so it carries its own
# gitlink; the parent must never see them as content.
.worktree/
# Visual self-check output (styles/preview renders); never part of the package.
.preview*
